# ===== Configuration LLM (API compatible OpenAI) =====
# Toute API au format OpenAI SDK est supportée (Qwen, GPT, modèles locaux...)
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL_NAME=gpt-4o-mini

# ===== Zep (graphe d'interdépendances / mémoire GraphRAG) =====
# Quota mensuel gratuit suffisant pour un usage simple : https://app.getzep.com/
ZEP_API_KEY=your_zep_api_key_here

# ===== LLM "boost" optionnel (2e fournisseur, parallélisation) =====
# Si non utilisé, ne pas laisser ces lignes dans le .env
# LLM_BOOST_API_KEY=your_api_key_here
# LLM_BOOST_BASE_URL=your_base_url_here
# LLM_BOOST_MODEL_NAME=your_model_name_here
