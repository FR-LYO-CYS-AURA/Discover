# ===== Backend LLM =====
# 'opencode' (défaut) : utilise le harness OpenCode. Aucune clé LLM requise ici :
#   l'authentification et le modèle sont gérés par OpenCode ('opencode auth login').
# 'openai' : appel direct au format OpenAI (nécessite LLM_API_KEY ci-dessous).
LLM_BACKEND=opencode

# ===== Harness OpenCode (si LLM_BACKEND=opencode) =====
# URL du serveur OpenCode. Par défaut, DISCOVER lance et gère lui-même
# 'opencode serve' sur cette adresse (répertoire de travail neutre).
OPENCODE_SERVER_URL=http://127.0.0.1:47600
# Mettre 'false' pour se connecter à un serveur OpenCode déjà lancé (non managé).
OPENCODE_MANAGED=true
# Chemin/nom du binaire OpenCode (si absent du PATH).
# OPENCODE_BIN=opencode
# Modèle optionnel 'providerID/modelID' (ex. github-copilot/claude-sonnet-4.6).
# Vide = modèle par défaut configuré dans OpenCode.
# OPENCODE_MODEL=
# Agent OpenCode optionnel.
# OPENCODE_AGENT=
# Auth basique optionnelle du serveur OpenCode.
# OPENCODE_SERVER_PASSWORD=
# OPENCODE_SERVER_USERNAME=opencode

# ===== Backend OpenAI (si LLM_BACKEND=openai) =====
# LLM_API_KEY=your_api_key_here
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL_NAME=gpt-4o-mini

# ===== Zep (graphe d'interdépendances / mémoire GraphRAG) =====
# Requis uniquement pour la construction du graphe Zep (fonctionnalité ultérieure).
# ZEP_API_KEY=your_zep_api_key_here

# ===== Trace d'exécution (debug / pédagogie) =====
# Trace les fichiers/fonctions du package app/ réellement exécutés, dans l'ordre
# chronologique et par requête, vers backend/logs/trace-AAAA-MM-JJ.log.
# Désactivée par défaut (aucun surcoût). Mettre 'true' pour activer.
TRACE_EXECUTION=false
# Inclure aussi les retours de fonctions (←) avec la durée de chaque appel.
TRACE_INCLUDE_RETURNS=false
# Profondeur maximale d'appels tracée (0 = illimité).
TRACE_MAX_DEPTH=0
# Écrire les récapitulatifs dédupliqués des fichiers utilisés (par scope + global).
# Récap global disponible à la demande via GET /api/trace/summary et à l'arrêt.
TRACE_SUMMARY=true
# Seuil anti-bruit : n'émet un récap de scope que si >= N fichiers distincts.
TRACE_SUMMARY_MIN_FILES=1
